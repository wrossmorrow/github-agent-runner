{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "agentrunner-controller values",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "serviceAccount", "rbac", "controller"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arcControllerNamespace",
        "arcControllerServiceAccount",
        "githubAuthImage",
        "imagePullPolicy",
        "metricsBindAddress",
        "healthProbeBindAddress"
      ],
      "properties": {
        "arcVersion": {
          "type": "string"
        },
        "arcControllerNamespace": {
          "type": "string",
          "minLength": 1
        },
        "arcControllerServiceAccount": {
          "type": "string",
          "minLength": 1
        },
        "githubAuthImage": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "leaderElect": {
          "type": "boolean"
        },
        "metricsBindAddress": {
          "type": "string",
          "minLength": 1
        },
        "healthProbeBindAddress": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number"]
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
